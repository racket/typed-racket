#lang typed/racket/base
(require typed/rackunit)
(: float-complex/direct? (Any -> Boolean : Float-Complex))
(define (float-complex/direct? x)
  (and (number? x) (flonum? (real-part x)) (flonum? (imag-part x))))
(: reversed? (Any -> Boolean : Float-Complex))
(define (reversed? x)
  (and (number? x) (flonum? (imag-part x)) (flonum? (real-part x))))
(: single-complex/direct? (Any -> Boolean : Single-Flonum-Complex))
(define (single-complex/direct? x)
  (and (number? x) (single-flonum? (real-part x)) (single-flonum? (imag-part x))))
(: real-float? (Any -> Boolean : (U Flonum Float-Complex)))
(define (real-float? x) (and (number? x) (flonum? (real-part x))))
(: fixnum-part (Fixnum -> Fixnum))
(define (fixnum-part x) (real-part x))
(: aliases? (Any -> Boolean : Float-Complex))
(define (aliases? x)
  (and (number? x)
       (let ([r (real-part x)] [i (imag-part x)])
         (and (flonum? r) (flonum? i)))))
(for ([x : Any (list #f 0 1/2 1+2i 0.0 -0.0 +inf.0 +nan.0)])
  (check-false (float-complex/direct? x))
  (check-false (reversed? x)))
(for ([x : Any (list 1.0+2.0i -0.0-0.0i +inf.0+nan.0i)])
  (check-true (float-complex/direct? x))
  (check-true (reversed? x))
  (check-true (aliases? x)))
(check-equal? (fixnum-part 42) 42)


(: refine-component (Number -> Flonum))
(define (refine-component x)
  (define r (real-part x))
  (if (float-complex/direct? x) r 0.0))
(check-equal? (refine-component 1.0+2.0i) 1.0)

(: exact-number/direct? (Any -> Boolean : Exact-Number))
(define (exact-number/direct? x)
  (and (number? x) (exact? (real-part x)) (exact? (imag-part x))))
(: inexact-complex/direct? (Any -> Boolean : Inexact-Complex))
(define (inexact-complex/direct? x)
  (and (number? x) (inexact-real? (real-part x)) (inexact-real? (imag-part x))))

(for ([x : Any (list #f 'symbol)])
  (check-false (exact-number/direct? x))
  (check-false (inexact-complex/direct? x))
  (check-false (real-float? x)))
(for ([x : Any (list 0 -1 1/2 1+2i 0+2i)])
  (check-true (exact-number/direct? x))
  (check-false (inexact-complex/direct? x)))
(for ([x : Any (list 0.0 -0.0 +inf.0 +nan.0)])
  (check-false (exact-number/direct? x))
  (check-false (inexact-complex/direct? x))
  (check-true (real-float? x)))
(for ([x : Any (list 1.0+2.0i -0.0-0.0i +inf.0+nan.0i)])
  (check-false (exact-number/direct? x))
  (check-true (inexact-complex/direct? x))
  (check-true (real-float? x))
  (check-false (single-complex/direct? x)))
(let ([x (make-rectangular 0 2.0)])
  (check-false (exact-number/direct? x))
  (check-equal? (inexact-complex/direct? x) (inexact? (real-part x)))
  (check-equal? (real-float? x) (flonum? (real-part x))))
(when (single-flonum-available?)
  (define x (make-rectangular (real->single-flonum 1.0)
                             (real->single-flonum 2.0)))
  (check-true (single-complex/direct? x))
  (check-true (inexact-complex/direct? x))
  (check-false (float-complex/direct? x))
  (check-false (exact-number/direct? x))
  (check-false (real-float? x)))
